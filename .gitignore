# Large/generated artifact payloads are ignored by default.
artifacts/features/
artifacts/predictions/
artifacts/stage2/
artifacts/feature_generation_runs/
artifacts/run_records/
artifacts/weights/
artifacts/**/*.png
artifacts/**/*.pt
artifacts/**/*.pth
artifacts/**/*.safetensors

# Lightweight documentation, paper records, thresholds, and explicitly
# selected detector checkpoints remain committable.
!artifacts/README.md
!artifacts/paper_results/
!artifacts/paper_results/**
!artifacts/thresholds/
!artifacts/thresholds/**
!artifacts/detector_checkpoints/
!artifacts/detector_checkpoints/**
__pycache__/
*.py[cod]
.venv/
.env
*.log
